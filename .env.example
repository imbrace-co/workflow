# =============================================================================
# Activepieces (ap-workflow) — environment template
#
# This is the single source of truth for every environment variable the stack
# reads. Copy it to whichever file your compose target expects, then fill in
# the blanks:
#
#   docker-compose.local.yml   ->  .env.local
#   docker-compose.be.yml      ->  .env.backend.dev
#   docker-compose.engine.yml  ->  .env.engine.dev
#   docker-compose.fe.yml      ->  .env.frontend.dev
#   docker-compose.yml         ->  .env, .env.engine, .env.frontend
#   docker-compose.infra.yml   ->  .env
#
#   cp .env.example .env.local && $EDITOR .env.local
#
# Every one of those files is gitignored. NEVER commit a filled-in copy, and
# never paste a real secret back into this template.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
AP_DB_TYPE=POSTGRES
AP_POSTGRES_DATABASE=activepieces
# Use `localhost` when running natively, or the compose service name
# (e.g. `postgres`) / `host.docker.internal` when running in Docker.
AP_POSTGRES_HOST=localhost
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=activepieces
# REQUIRED — must match the password your Postgres instance was created with.
AP_POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
AP_REDIS_TYPE=STANDALONE
AP_REDIS_HOST=localhost
AP_REDIS_PORT=6379
AP_REDIS_DB=0

# Additional Redis configuration consumed by the client
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# Security — REQUIRED, no defaults, generate a unique value per environment
# -----------------------------------------------------------------------------
# Encrypts app-connection credentials (OAuth tokens, third-party API keys) at
# rest in Postgres. Changing this after data exists makes every stored
# connection undecryptable — plan a re-encryption migration before rotating.
#   Generate: openssl rand -hex 16
AP_ENCRYPTION_KEY=

# Signs and verifies API tokens.
#   Generate: openssl rand -hex 32
AP_JWT_SECRET=

# Internal API key for service-to-service calls.
#   Generate: openssl rand -hex 32
AP_API_KEY=

# Platform identifier this deployment is bound to. Ask a maintainer for the
# value that matches your target environment.
AP_SHARED_PLATFORM_ID=

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
AP_ENVIRONMENT=dev
AP_FRONTEND_URL=http://localhost:4200
AP_INTERNAL_URL=http://localhost:4200/api
AP_BACKEND_URL=http://localhost:3000
AP_WEBHOOK_URL="http://localhost:3000"
ENGINE_URL=http://localhost:3001
GATEWAY_URL=http://localhost:9001/activepieces

# -----------------------------------------------------------------------------
# Engine / worker
# -----------------------------------------------------------------------------
NODE_ENV=development
ENGINE_PORT=3001
AP_ENGINE_WS_PORT=12345
WORKER_ID=engine-worker-1
AP_EXECUTION_MODE=UNSANDBOXED
AP_BASE_CODE_DIRECTORY=/usr/src/app/codes
AP_CACHE_PATH=/usr/src/app/cache

# -----------------------------------------------------------------------------
# Pieces
# -----------------------------------------------------------------------------
AP_PIECES_SOURCE='BUILTIN'
AP_PIECES_SYNC_MODE=BUILTIN

# Only used when AP_PIECES_SOURCE='FILE' — the pieces to build and hot-reload.
#AP_DEV_PIECES="webhook,whatsapp,http,common,framework,send-message"
#AP_DEV_PIECES="webhook,google-sheets,whatsapp,http,common,common-ai,framework,send-message,ask-a-question,automate-data-board,document-ai,ai-connector"

# -----------------------------------------------------------------------------
# Timeouts and telemetry
# -----------------------------------------------------------------------------
AP_TELEMETRY_ENABLED=false
AP_TRIGGER_DEFAULT_POLL_INTERVAL=1
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_FLOW_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Nx
# -----------------------------------------------------------------------------
NX_DAEMON=false
NX_PLUGIN_NO_TIMEOUTS=true

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_CLIENT_ID=
# Broker list, comma-separated. Ask a maintainer for the endpoint that matches
# your target environment.
KAFKA_ENDPOINT=
KAFKA_USE_SSL=false
KAFKA_USE_SASL=false
KAFKA_SASL_MECHANISM=plain
# REQUIRED when KAFKA_USE_SASL=true. Retrieve from your secret store, never
# hardcode. Leave blank for a local plaintext broker.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_PARTITION=

# Set to true only when targeting AWS MSK with IAM auth.
KAFKA_IS_AWS_KAFKA=false
#KAFKA_AUTH_METHOD=iam
#KAFKA_AWS_REGION=

# Allow self-signed broker certificates. Keep `true` in production.
KAFKA_SSL_REJECT_UNAUTHORIZED=true

KAFKA_CONSUMER_GROUP_ID=activepieces-flows
KAFKA_TOPIC=AP_INCOMING_MESSAGE
KAFKA_AUTO_COMMIT=false
KAFKA_MAX_BYTES_PER_PARTITION=1048576
KAFKA_FROM_BEGINNING=false

# -----------------------------------------------------------------------------
# AWS — leave blank to use the ambient credential chain (IAM role, ~/.aws)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# -----------------------------------------------------------------------------
# External services
# -----------------------------------------------------------------------------
# Next-best-action suggestion API. Ask a maintainer for the environment URL.
MESSAGE_SUGGESTION_API=
