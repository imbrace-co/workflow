### STAGE 1: build (full toolchain, identical build steps to before) ###
FROM node:20.19-bullseye-slim AS build

ARG NODE_MEMORY=4096

WORKDIR /usr/src/app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        g++ \
        build-essential \
        pkg-config \
        git \
        procps \
        curl \
        ca-certificates \
        unzip && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install bun and verify installation in one layer
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.1" && \
    /root/.bun/bin/bun --version

ENV BUN_INSTALL="/root/.bun"
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

# Set environment variables
ENV NX_DAEMON=false

# redis-memory-server only backs REDIS_TYPE=MEMORY, used for local dev and
# tests; deployments run STANDALONE. Its postinstall compiles Redis plus four
# modules from source, which needs a toolchain this image does not carry.
# Skip it via the package's own opt-out — narrower than --ignore-scripts,
# which would also skip the native builds (bcrypt, better-sqlite3, ssh2).
ENV REDISMS_DISABLE_POSTINSTALL=1
ENV NX_PLUGIN_NO_TIMEOUTS=true
ENV ENGINE_PORT=3001
ENV AP_EXECUTION_MODE=UNSANDBOXED
ENV NODE_OPTIONS="--max-old-space-size=${NODE_MEMORY}"


# Copy workspace configuration files
COPY .npmrc package.json bun.lock tsconfig.base.json nx.json .eslintrc.json .eslintrc.base.json jest.config.ts ./

# Install global npm packages in a single layer
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-fund --no-audit \
    node-gyp \
    npm@9.9.3 \
    pm2@6.0.10 \
    typescript@4.9.4

# Install isolated-vm globally (needed for sandboxes)
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd /usr/src && bun install isolated-vm@5.0.1

# Install dependencies using the full bun path (without frozen lockfile)
RUN ${BUN_INSTALL}/bin/bun install

# Copy all necessary source code for NX workspace
COPY ./packages ./packages

# Build shared package first (dependency for pieces and engine)
RUN npx nx build shared

# Build pieces packages (framework, common, common-ai, and all available community pieces)
# RUN npx nx build pieces-framework
# RUN npx nx build pieces-common
# RUN npx nx build common-ai

# Build all available community pieces (runtime will filter based on AP_DEV_PIECES environment variable)
# This will attempt to build all pieces and skip any that have build errors
# The pieces are built using the pnpm workspace which handles dependencies correctly
# RUN npx nx run-many --target=build --projects='pieces-*' --skip-nx-cache || true

# Create node_modules symlinks for runtime resolution
# Copy the built framework packages to node_modules so they can be found at runtime
RUN mkdir -p node_modules/@activepieces
# RUN cp -r dist/packages/pieces/community/framework node_modules/@activepieces/pieces-framework
# RUN cp -r dist/packages/pieces/community/common node_modules/@activepieces/pieces-common
# RUN cp -r dist/packages/shared node_modules/@activepieces/shared
# RUN cp -r dist/packages/pieces/community/common-ai node_modules/@activepieces/common-ai

# Build the engine
RUN npx nx build engine

# Build a self-contained node_modules for the engine's webpack externals
# (see packages/engine/webpack.config.js). The engine require()s these at
# runtime; aws-msk-iam-sasl-signer-js is required EAGERLY at startup. They are
# resolved from the workspace-root node_modules. Versions are pinned to whatever
# the workspace install resolved, then re-installed into an isolated tree.
RUN mkdir -p /tmp/engine-externals && \
    node -e "const fs=require('fs');const names=['utf-8-validate','bufferutil','@aws-sdk/client-sts','@aws-sdk/credential-providers','@aws-sdk/credential-provider-node','@aws-sdk/credential-provider-env','@aws-sdk/credential-provider-process','@aws-sdk/credential-provider-ini','@aws-sdk/credential-provider-ec2','@aws-sdk/credential-provider-container','@aws-sdk/credential-provider-sso','@aws-sdk/credential-provider-web-identity','@aws-sdk/credential-provider-imds','@aws-sdk/credential-provider-cognito-identity','@aws-sdk/util-format-url','@smithy/property-provider','@smithy/shared-ini-file-loader','@smithy/credential-provider-imds','aws-msk-iam-sasl-signer-js','kerberos','@mongodb-js/zstd','snappy','mongodb-client-encryption'];const deps={};for(const n of names){try{deps[n]=require(n+'/package.json').version;}catch(e){console.log('skip (not installed): '+n);}}fs.writeFileSync('/tmp/engine-externals/package.json',JSON.stringify({name:'engine-externals',version:'0.0.1',dependencies:deps},null,2));console.log('engine externals:',Object.keys(deps).join(', '));"
RUN --mount=type=cache,target=/root/.bun/install/cache \
    cd /tmp/engine-externals && bun install --production

### STAGE 2: run (slim) ###
FROM node:20.19-bullseye-slim AS run

ARG NODE_MEMORY=4096

WORKDIR /usr/src/app

# Runtime-only apt deps. No build toolchain, no bun (engine does not compile Code steps).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        procps \
        ca-certificates && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Preserve all runtime ENV from the original engine image
ENV NX_DAEMON=false
ENV NX_PLUGIN_NO_TIMEOUTS=true
ENV ENGINE_PORT=3001
ENV AP_EXECUTION_MODE=UNSANDBOXED
ENV NODE_OPTIONS="--max-old-space-size=${NODE_MEMORY}"

# Built engine bundle + sourcemap and shared dist
COPY --from=build /usr/src/app/dist/packages/engine ./dist/packages/engine
COPY --from=build /usr/src/app/dist/packages/shared ./dist/packages/shared

# Engine webpack externals, resolved from the workspace-root node_modules
COPY --from=build /tmp/engine-externals/node_modules ./node_modules

# Empty @activepieces dir, preserving original behavior
RUN mkdir -p node_modules/@activepieces

# Recreate runtime working dirs the original image made
RUN mkdir -p /usr/src/app/cache && chmod 755 /usr/src/app/cache
RUN mkdir -p /usr/src/app/codes && chmod 755 /usr/src/app/codes

# Expose port
EXPOSE 3001

# Start the application with source maps enabled
CMD ["node", "--enable-source-maps", "dist/packages/engine/main.js"]
